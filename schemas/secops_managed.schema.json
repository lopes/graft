{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secops_managed.schema.json",
  "title": "Google SecOps Curated RuleSets Manifest Schema",
  "type": "object",
  "required": [
    "rulesets"
  ],
  "properties": {
    "rulesets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "deployments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "deployments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "enabled",
                "alerting"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "PRECISE",
                    "BROAD"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "alerting": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "expression"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "ruleset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
