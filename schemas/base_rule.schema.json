{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base_rule.schema.json",
  "title": "Graft Base Rule Envelope Schema",
  "type": "object",
  "required": [
    "metadata",
    "logic",
    "deployment",
    "runbook",
    "tests"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "testing",
            "production",
            "deprecated"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "authors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "mitre": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T\\d{4}(\\.\\d{3})?$"
            }
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_/\\-]+$",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2048
          }
        }
      },
      "additionalProperties": false
    },
    "logic": {
      "type": "string",
      "minLength": 1
    },
    "deployment": {
      "type": "object"
    },
    "runbook": {
      "type": "object",
      "required": [
        "context",
        "triage",
        "response"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "triage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "expect",
          "events"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expect": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "timestamp",
                "payload"
              ],
              "properties": {
                "timestamp": {
                  "type": "string"
                },
                "payload": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
