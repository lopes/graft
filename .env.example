# ==============================================================================
# Graft: Environment Configuration Template (.env.example)
# ==============================================================================
#
# LOCAL RUNS ONLY:
# This file is a reference template for local developer and operator workstations.
# To configure your local environment:
#   1. Copy this file to '.env':
#        cp .env.example .env
#   2. Fill in the credentials and coordinates for the engines you use.
#   3. The '.env' file is strictly git-ignored and must NEVER be committed.
#
# CI/CD (GITHUB ACTIONS) RUNS:
# In automated CI/CD pipelines, do NOT use or commit a .env file.
# Workflows must source credentials directly from GitHub Repository / Environment
# Secrets (e.g. env: GRAFT_SECOPS_PROD_PROJECT: ${{ secrets.GRAFT_SECOPS_PROD_PROJECT }}).
#
# ARCHITECTURE:
# Graft separates platform-wide variables (Core) from engine-specific credentials:
# - Core variables: GRAFT_* (apply platform-wide across all engines)
# - Engine variables: GRAFT_<ENGINE>_* (isolated per engine: SECOPS, CROWDSTRIKE, etc.)
# ==============================================================================

# ==============================================================================
# 1. CORE / PLATFORM CONFIGURATION (Cross-Engine)
# ==============================================================================
# Platform log verbosity: DEBUG, INFO, WARNING, ERROR
# GRAFT_LOG_LEVEL=INFO

# Optional: GitHub token for repository metadata, release tracking, or PR automation
# GRAFT_GITHUB_TOKEN=


# ==============================================================================
# 2. ENGINE: GOOGLE SECOPS (Chronicle SIEM)
# ==============================================================================
# Mode A: Single-Tenant / Lab Setup (Testing & Production share the same instance)
# When configured, Graft uses these coordinates for both staging and production,
# and emits an advisory notice during replay tests to remind you of potential alert noise.
#
GRAFT_SECOPS_PROJECT=your-gcp-project-id
GRAFT_SECOPS_LOCATION=us
GRAFT_SECOPS_INSTANCE_ID=00000000-0000-0000-0000-000000000000

# Optional: Service account email to impersonate (requires roles/iam.serviceAccountTokenCreator)
# GRAFT_SECOPS_SA_EMAIL=graft-runner@your-gcp-project-id.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# Mode B: Multi-Tenant Enterprise Setup (Segregated Staging and Production)
# In production enterprise environments, maintain separate Staging and Production
# tenants so synthetic test replays never pollute production triage queues.
#
# --- Staging Tenant (Quarantine, Syntax Validation & Synthetic Replay) ---
# GRAFT_SECOPS_STAGING_PROJECT=your-staging-project-id
# GRAFT_SECOPS_STAGING_LOCATION=us
# GRAFT_SECOPS_STAGING_INSTANCE_ID=11111111-1111-1111-1111-111111111111
# GRAFT_SECOPS_STAGING_SA_EMAIL=graft-staging-sa@your-staging-project-id.iam.gserviceaccount.com

# --- Production Tenant (Live Rule Deployment & Curated Managed State) ---
# GRAFT_SECOPS_PROD_PROJECT=your-prod-project-id
# GRAFT_SECOPS_PROD_LOCATION=us
# GRAFT_SECOPS_PROD_INSTANCE_ID=22222222-2222-2222-2222-222222222222
# GRAFT_SECOPS_PROD_SA_EMAIL=graft-prod-sa@your-prod-project-id.iam.gserviceaccount.com

# Optional: Explicit OAuth2 bearer token override (takes precedence over gcloud / ADC)
# GRAFT_SECOPS_TOKEN=
