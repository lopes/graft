# Python bytecode & compiled extensions
__pycache__/
*.py[codz]
*$py.class
*.so

# Build & distribution artifacts
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments & uv
.venv/
venv/
env/
ENV/

# Testing, coverage & static analysis caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.cache/

# Secrets, environment variables & cloud credentials (root and src/graft/engines/*/)
.env*
!.env.example
.envrc
*.key.json
*service_account*.json
*credentials*.json
credentials/
.pypirc

# Graft generated export artifacts (catalogs, matrices, Navigator layers)
exports/*
!exports/.gitkeep
layers/
