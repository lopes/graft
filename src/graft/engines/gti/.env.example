# ==============================================================================
# ENGINE: GTI (Google Threat Intelligence / VirusTotal v3)
# ==============================================================================
# Provisioned via src/graft/engines/gti/docs/README.md.
# Copy this file to 'src/graft/engines/gti/.env'.
#
# Authentication mechanics:
# - Graft authenticates against the GTI v3 REST API (https://www.virustotal.com/api/v3)
#   using the 'x-apikey' HTTP header.
#
# --- Mode A: Single-Tenant / Standard Setup ---
export GRAFT_GTI_API_KEY="your-gti-api-key"

# ------------------------------------------------------------------------------
# --- Mode B: Segregated Staging & Production Keys (Optional) ---
# export GRAFT_GTI_STAGING_API_KEY="your-staging-gti-api-key"
# export GRAFT_GTI_PROD_API_KEY="your-prod-gti-api-key"

# Optional ruleset discovery scope (defaults to "owner:self" so Graft manages only
# rulesets and Retrohunt jobs created by the dedicated non-admin Graft GTI user
# account; also accepts "tag:<tag>" or "all"):
# export GRAFT_GTI_FILTER="owner:self"

# Optional comma-separated default notification emails for alerting rulesets:
# export GRAFT_GTI_NOTIFICATION_EMAILS="soc-alerts@example.com"

# Optional API base URL override (HTTPS required):
# export GRAFT_GTI_BASE_URL="https://www.virustotal.com/api/v3"
