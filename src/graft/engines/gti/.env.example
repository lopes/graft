# ==============================================================================
# ENGINE: GTI (Google Threat Intelligence / VirusTotal v3)
# ==============================================================================
# Provisioned via src/graft/engines/gti/docs/README.md.
# Copy this file to 'src/graft/engines/gti/.env' (or merge into root '.env').
#
# Authentication & Isolation Mechanics:
# - Graft authenticates against the GTI v3 REST API (https://www.virustotal.com/api/v3)
#   using the 'x-apikey' HTTP header of a dedicated non-admin GTI User Account.
# - Under the default GRAFT_GTI_FILTER="owner:self", Graft queries and mutates only
#   Livehunt rulesets and Retrohunt jobs owned by that dedicated account.
#
# --- Mode A: Single-Account / Standard Setup (Recommended) ---
# One dedicated non-admin GTI account (e.g., graft-automation@acme.com) used for both
# pre-merge YARA-X compiler dry-runs (transient disabled probe rulesets) and production
# Livehunt / Retrohunt synchronization.
export GRAFT_GTI_API_KEY="your-64-char-gti-api-key"

# Ruleset discovery scope: "owner:self" (default), "tag:<tag>", or "all"
export GRAFT_GTI_FILTER="owner:self"

# Optional comma-separated default notification emails for Livehunt / Retrohunt matches
# when a rule's 'deployment.notification_emails' is omitted:
# export GRAFT_GTI_NOTIFICATION_EMAILS="soc-alerts@acme.com"

# ------------------------------------------------------------------------------
# --- Mode B: Dual-Account Setup (Optional Segregated Staging & Production Keys) ---
# If your GTI organization provisions separate Staging and Production bot accounts,
# uncomment the tiered keys below. 'graft gti verify' and 'graft gti test' (--env staging)
# use GRAFT_GTI_STAGING_API_KEY; 'graft gti diff/apply/pull' (--env production) use
# GRAFT_GTI_PROD_API_KEY, falling back to GRAFT_GTI_API_KEY whenever unset.
#
# export GRAFT_GTI_STAGING_API_KEY="your-staging-64-char-gti-api-key"
# export GRAFT_GTI_PROD_API_KEY="your-prod-64-char-gti-api-key"

# Optional API base URL override (HTTPS required):
# export GRAFT_GTI_BASE_URL="https://www.virustotal.com/api/v3"
