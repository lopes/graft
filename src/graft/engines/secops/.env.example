# ==============================================================================
# ENGINE: SECOPS (Google SecOps / Chronicle SIEM)
# ==============================================================================
# Provisioned via src/graft/engines/secops/docs/setup_and_auth.md.
# Copy this file to 'src/graft/engines/secops/.env' (or merge into root '.env').
#
# Authentication mechanics:
# - Local CLI: Graft calls 'gcloud' using your personal login to impersonate
#   the Service Account. Zero static keys or WIF required locally.
# - GitHub Actions CI/CD: Headless runner authenticates using WIF Provider +
#   SA Email via OIDC, eliminating static keys.
#
# --- Mode A: Single-Tenant / Standard Setup (Shared Instance) ---
# When only PROD coordinates are defined, Graft automatically falls back to them
# for staging verification and replay tests, issuing a non-alerting advisory notice.
#
export GRAFT_SECOPS_PROD_PROJECT="your-gcp-project-id"
export GRAFT_SECOPS_PROD_LOCATION="us"
export GRAFT_SECOPS_PROD_INSTANCE_ID="00000000-0000-0000-0000-000000000000"
export GRAFT_SECOPS_PROD_SA_EMAIL="graft-secops-deployer@your-gcp-project-id.iam.gserviceaccount.com"
export GRAFT_SECOPS_WIF_PROVIDER="projects/1234567890/locations/global/workloadIdentityPools/graft-pool/providers/graft-gh-provider"

# ------------------------------------------------------------------------------
# --- Mode B: Multi-Tenant Enterprise Setup (Segregated Staging & Production) ---
# In enterprise environments with separate Staging and Production tenants,
# configure staging coordinates below so synthetic test replays are physically
# quarantined from production triage queues.
#
# --- Staging Tenant (Quarantine, Syntax Validation & Synthetic Replay) ---
# export GRAFT_SECOPS_STAGING_PROJECT="your-staging-project-id"
# export GRAFT_SECOPS_STAGING_LOCATION="us"
# export GRAFT_SECOPS_STAGING_INSTANCE_ID="11111111-1111-1111-1111-111111111111"
# export GRAFT_SECOPS_STAGING_SA_EMAIL="graft-secops-deployer@your-staging-project-id.iam.gserviceaccount.com"

# --- Production Tenant (Live Rule Deployment & Curated Managed State) ---
# export GRAFT_SECOPS_PROD_PROJECT="your-prod-project-id"
# export GRAFT_SECOPS_PROD_LOCATION="us"
# export GRAFT_SECOPS_PROD_INSTANCE_ID="22222222-2222-2222-2222-222222222222"
# export GRAFT_SECOPS_PROD_SA_EMAIL="graft-secops-deployer@your-prod-project-id.iam.gserviceaccount.com"
# export GRAFT_SECOPS_WIF_PROVIDER="projects/1234567890/locations/global/workloadIdentityPools/graft-pool/providers/graft-gh-provider"

# Optional: Explicit OAuth2 bearer token override (takes precedence over gcloud / ADC)
# export GRAFT_SECOPS_TOKEN=""
