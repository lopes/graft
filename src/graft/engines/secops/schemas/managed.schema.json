{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secops_managed.schema.json",
  "title": "Google SecOps Curated RuleSets Manifest Schema",
  "type": "object",
  "required": [
    "exclusions"
  ],
  "oneOf": [
    {
      "required": [
        "categories"
      ]
    },
    {
      "required": [
        "rulesets"
      ]
    }
  ],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "id",
          "rulesets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "rulesets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "deployments"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_\\-]+$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "deployments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "enabled",
                      "alerting"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "PRECISE",
                          "BROAD"
                        ]
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "alerting": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rulesets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "deployments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "category_id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "deployments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "enabled",
                "alerting"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "PRECISE",
                    "BROAD"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "alerting": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "ruleset_id",
          "expression",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "ruleset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
