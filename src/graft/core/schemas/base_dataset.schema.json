{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base_dataset.schema.json",
  "title": "Graft Base Dataset Envelope Schema",
  "type": "object",
  "required": [
    "metadata",
    "values"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "description",
        "owners",
        "tags",
        "references"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "not": {
            "const": "index"
          },
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_/\\-]+$",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "values": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": false
}
